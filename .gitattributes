# Force LF for shell scripts (prevents CRLF breaking shebangs on Linux)
*.sh   text eol=lf
*.bash text eol=lf

# Python — let Git handle via autocrlf (or force LF if preferred)
*.py   text eol=lf

# JSON locales — keep LF
*.json text eol=lf

# HTML/CSS/JS — normalize to LF
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Markdown
*.md   text eol=lf

# Binary — no conversion
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary

*.sh text eol=lf
