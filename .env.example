# Unit3Dup G3MINI — Variables d'environnement Docker
# Copier ce fichier en .env et adapter les valeurs avant de lancer docker compose.

# ── Permissions fichiers ───────────────────────────────────────────────────────
# UID et GID de l'utilisateur hôte qui possède les fichiers media.
# Trouver vos valeurs : id -u && id -g
PUID=1000
PGID=1000

# ── Fuseau horaire ─────────────────────────────────────────────────────────────
TZ=Europe/Paris

# ── Port du dashboard web ─────────────────────────────────────────────────────
WEB_PORT=5000

# ── Dossier source media ──────────────────────────────────────────────────────
# Chemin absolu vers la médiathèque sur l'hôte.
# Ce dossier sera monté en /media dans les deux services (web et watcher).
MEDIA_DIR=/chemin/vers/vos/medias

# ── CORS Socket.IO (optionnel — reverse proxy uniquement) ─────────────────────
# Laisser vide pour le comportement automatique :
#   - U3D_WEB_HOST=0.0.0.0 (défaut Docker) → accepte toutes les origines
#   - U3D_WEB_HOST=<IP>                    → restreint à cette IP
# Renseigner uniquement si un reverse proxy sert le dashboard sous un domaine
# différent du conteneur (ex: https://unit3dup.mondomaine.com).
# Plusieurs origines séparées par des virgules.
# U3D_CORS_ORIGINS=https://unit3dup.mondomaine.com
